{
  "name": "agentarena-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent coding benchmark, objective evaluation and evidence-based routing on top of HarnessRouter.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "eval:rerun": "tsx scripts/reevaluate.ts",
    "demo:live": "tsx scripts/live-demo.ts",
    "sandbox:pull": "docker pull node:22-alpine && docker pull python:3.12-alpine",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.511.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "typescript": "^5.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.0",
    "prettier": "^3.5.3",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12"
  }
}
