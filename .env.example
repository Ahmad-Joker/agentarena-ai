# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml (loopback only, development credentials).
DATABASE_URL="postgresql://agentarena:agentarena_local_only@127.0.0.1:5433/agentarena?schema=public"

# ─── Execution mode ──────────────────────────────────────────────────────────
# DEMO  = deterministic simulated agents, no network calls, no cost.
# LIVE  = real HarnessRouter executions (billable). Requires the variables below.
AGENTARENA_MODE="DEMO"

# Second, explicit opt-in for billable executions. Even in LIVE mode, the UI
# additionally asks for a per-benchmark confirmation.
ALLOW_LIVE_EXECUTION="false"

# ─── HarnessRouter (server-side only, never exposed to the browser) ─────────
# Cloud:            https://api.harnessrouter.ai
# Community Edition: http://localhost:3000/api/harness
HR_BASE_URL="https://api.harnessrouter.ai"
# Create a Workspace API key in the HarnessRouter console. Do not commit it.
HR_API_KEY=""

# ─── Evaluation sandbox ──────────────────────────────────────────────────────
# "docker" runs generated code in network-less, resource-limited containers.
# "disabled" runs static analysis only and reports runtime tests as unavailable.
SANDBOX_MODE="docker"
SANDBOX_NODE_IMAGE="node:22-alpine"
SANDBOX_PYTHON_IMAGE="python:3.12-alpine"
SANDBOX_TIMEOUT_MS="15000"

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_RUNS="2"
DEFAULT_RUN_TIMEOUT_SECONDS="600"
